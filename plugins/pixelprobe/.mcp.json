{
  "mcpServers": {
    "pixelprobe": {
      "command": "uvx",
      "args": [
        "--python", "3.12",
        "--from", "pixelprobe[mcp] @ git+https://github.com/2061863797/PixelProbe.git@v2.1.0",
        "pixelprobe-mcp"
      ],
      "env": {
        "PIXELPROBE_MCP_ROOTS": "${user_config.media_roots}",
        "PIXELPROBE_MCP_TOTAL_MEMORY_MB": "${user_config.total_memory_mb}"
      }
    }
  }
}
